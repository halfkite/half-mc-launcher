{
  "name": "half-mc-launcher",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@xmcl/unzip": {
      "@xmcl/yauzl": "2.10.0"
    }
  },
  "description": "Half Mc Launcher — Minecraft 实例与资源管理",
  "author": "Hakf",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "postinstall": "node scripts/prepare.mjs",
    "build": "vue-tsc --noEmit && vite build --configLoader runner && node scripts/build.mjs",
    "start": "electron .",
    "test": "vitest run --configLoader runner",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win portable --publish never",
    "test:desktop": "node scripts/smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "test:loaders": "node scripts/r4-smoke.mjs",
    "test:auth": "node scripts/r4-auth-smoke.mjs",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-package.ps1",
    "desktop:test": "dotnet run --project desktop.Smoke/HalfMcLauncher.Smoke.csproj -c Release"
  },
  "devDependencies": {
    "@azure/msal-node": "7.1.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@xmcl/core": "2.16.2",
    "@xmcl/installer": "6.3.6",
    "@xmcl/unzip": "^2.2.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "lucide-vue-next": "^0.468.0",
    "typescript": "^5.9.0",
    "undici": "^7.30.1",
    "vite": "^7.0.0",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "^3.0.0",
    "yazl": "^2.5.1",
    "zod": "^4.0.0"
  },
  "build": {
    "appId": "app.half.minecraft.launcher",
    "productName": "Half Mc Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Half-Mc-Launcher-${version}-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ]
  }
}
